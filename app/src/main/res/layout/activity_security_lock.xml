<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutLockContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appSoftBgColor"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_two_hearts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="?attr/appPrimaryDarkColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/enter_pin_unlock_title"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/enter_pin_unlock_subtitle"
            android:textColor="?attr/appTextMutedColor"
            android:textSize="13sp" />

        <!-- 4 PIN Dot Indicators -->
        <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:src="@drawable/bg_pin_dot_off" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:src="@drawable/bg_pin_dot_off" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:src="@drawable/bg_pin_dot_off" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:src="@drawable/bg_pin_dot_off" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- Keypad Section -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1: 1, 2, 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="1"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="2"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="3"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <!-- Row 2: 4, 5, 6 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey4"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="4"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey5"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="5"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey6"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="6"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <!-- Row 3: 7, 8, 9 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey7"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="7"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey8"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="8"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey9"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="9"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <!-- Row 4: Biometric / Action, 0, Backspace -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyBiometric"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            app:icon="@drawable/ic_fingerprint"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="?attr/appPrimaryColor"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey0"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            android:text="0"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="24sp"
            android:textStyle="bold"
            app:strokeColor="?attr/appCardStrokeColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyDelete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_button"
            app:icon="@drawable/ic_backspace"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp"
            app:iconTint="?attr/appTextDarkColor"
            app:strokeColor="?attr/appCardStrokeColor" />

    </GridLayout>

</LinearLayout>