<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvBucketDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_bucket_item"
        android:textColor="?attr/appTextDarkColor"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bucket_list_subtitle"
        android:textColor="?attr/appTextMutedColor"
        android:textSize="13sp" />

    <!-- Title Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBucketTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/bucket_item_title_hint"
        app:boxStrokeColor="?attr/appPrimaryColor"
        app:hintTextColor="?attr/appPrimaryColor">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBucketTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBucketCategory"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/bucket_category_hint"
        app:boxStrokeColor="?attr/appPrimaryColor"
        app:hintTextColor="?attr/appPrimaryColor">

        <AutoCompleteTextView
            android:id="@+id/spinnerBucketCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="?attr/appTextDarkColor"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBucket"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="?attr/appTextMutedColor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBucket"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/save"
            android:textColor="@color/white"
            app:backgroundTint="?attr/appPrimaryColor" />
    </LinearLayout>

</LinearLayout>