<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEventItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/appCardStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main Info Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivEventIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle_pink"
                android:contentDescription="@string/events_title"
                android:padding="8dp"
                android:src="@drawable/ic_cake"
                app:tint="?attr/appPrimaryColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEventTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cumpleaños"
                    android:textColor="?attr/appTextDarkColor"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEventSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Aniversario • 15 de Mayo"
                    android:textColor="?attr/appTextMutedColor"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCountdownChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pink"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="12 días"
                android:textColor="?attr/appPrimaryColor"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEditEvent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/save"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="?attr/appPrimaryColor" />

            <ImageButton
                android:id="@+id/btnDeleteEvent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="?attr/appTextMutedColor" />

        </LinearLayout>

        <!-- Description Note / Memory Quote -->
        <TextView
            android:id="@+id/tvEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_pink"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="El día que nos mudamos juntos a nuestro nuevo departamento."
            android:textColor="?attr/appTextDarkColor"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <!-- Optional Memory Photo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEventPhotoContainer"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivEventPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/events_title"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>