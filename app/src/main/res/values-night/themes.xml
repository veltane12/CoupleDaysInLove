<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Romantic Material3 Theme for Dark Mode -->
    <style name="Base.Theme.CoupleDaysInLove" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/appPrimaryColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">?attr/appCardBgColor</item>
        <item name="colorOnPrimaryContainer">?attr/appTextDarkColor</item>
        <item name="colorSecondary">?attr/appAccentColor</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="android:statusBarColor">?attr/appSoftBgColor</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">?attr/appSoftBgColor</item>
    </style>

    <!-- Theme Option 1: Rosa Romántico (Dark) -->
    <style name="Theme.CoupleDaysInLove.Pink" parent="Base.Theme.CoupleDaysInLove">
        <item name="appPrimaryColor">#EC407A</item>
        <item name="appPrimaryLightColor">#F48FB1</item>
        <item name="appPrimaryDarkColor">#F06292</item>
        <item name="appAccentColor">#F48FB1</item>
        <item name="appSoftBgColor">#0E0E11</item>
        <item name="appCardBgColor">#221720</item>
        <item name="appCardStrokeColor">#3A2430</item>
        <item name="appTextDarkColor">#FCE4EC</item>
        <item name="appTextMutedColor">#F8BBD0</item>
    </style>

    <!-- Theme Option 2: Rojo Pasión (Dark) -->
    <style name="Theme.CoupleDaysInLove.Red" parent="Base.Theme.CoupleDaysInLove">
        <item name="appPrimaryColor">#FF5252</item>
        <item name="appPrimaryLightColor">#FF8A80</item>
        <item name="appPrimaryDarkColor">#FF1744</item>
        <item name="appAccentColor">#FF8A80</item>
        <item name="appSoftBgColor">#120E0E</item>
        <item name="appCardBgColor">#261617</item>
        <item name="appCardStrokeColor">#3E2224</item>
        <item name="appTextDarkColor">#FFEBEE</item>
        <item name="appTextMutedColor">#FFCDD2</item>
    </style>

    <!-- Theme Option 3: Lavanda Suave (Dark) -->
    <style name="Theme.CoupleDaysInLove.Purple" parent="Base.Theme.CoupleDaysInLove">
        <item name="appPrimaryColor">#AB47BC</item>
        <item name="appPrimaryLightColor">#E1BEE7</item>
        <item name="appPrimaryDarkColor">#CE93D8</item>
        <item name="appAccentColor">#E1BEE7</item>
        <item name="appSoftBgColor">#110E12</item>
        <item name="appCardBgColor">#211726</item>
        <item name="appCardStrokeColor">#382340</item>
        <item name="appTextDarkColor">#F3E5F5</item>
        <item name="appTextMutedColor">#E1BEE7</item>
    </style>

    <!-- Theme Option 4: Azul Cielo (Dark) -->
    <style name="Theme.CoupleDaysInLove.Blue" parent="Base.Theme.CoupleDaysInLove">
        <item name="appPrimaryColor">#29B6F6</item>
        <item name="appPrimaryLightColor">#81D4FA</item>
        <item name="appPrimaryDarkColor">#4FC3F7</item>
        <item name="appAccentColor">#81D4FA</item>
        <item name="appSoftBgColor">#0E1114</item>
        <item name="appCardBgColor">#16222A</item>
        <item name="appCardStrokeColor">#223847</item>
        <item name="appTextDarkColor">#E1F5FE</item>
        <item name="appTextMutedColor">#B3E5FC</item>
    </style>

    <!-- Theme Option 5: Menta Pastel (Dark) -->
    <style name="Theme.CoupleDaysInLove.Mint" parent="Base.Theme.CoupleDaysInLove">
        <item name="appPrimaryColor">#26A69A</item>
        <item name="appPrimaryLightColor">#80CBC4</item>
        <item name="appPrimaryDarkColor">#4DB6AC</item>
        <item name="appAccentColor">#80CBC4</item>
        <item name="appSoftBgColor">#0E1312</item>
        <item name="appCardBgColor">#162624</item>
        <item name="appCardStrokeColor">#223E3A</item>
        <item name="appTextDarkColor">#E0F2F1</item>
        <item name="appTextMutedColor">#B2DFDB</item>
    </style>

    <!-- Default Theme Alias for AndroidManifest -->
    <style name="Theme.CoupleDaysInLove" parent="Theme.CoupleDaysInLove.Pink" />

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/appCardBgColor</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>
</resources>